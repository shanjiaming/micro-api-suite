{
  "openapi": "3.0.3",
  "info": {
    "title": "Cron Schedule & Timezone Converter API",
    "version": "1.0.0",
    "description": "Parse 5-field cron expressions to compute next execution timestamps in any IANA timezone, and convert ISO timestamps across timezones."
  },
  "servers": [
    {
      "url": "https://micro-api-suite.onrender.com/apis/cron-timezone-utils"
    }
  ],
  "paths": {
    "/v1/cron/next": {
      "get": {
        "summary": "Compute next execution timestamps for a 5-field cron expression",
        "parameters": [
          {
            "name": "expr",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "0 9 * * 1-5"
            }
          },
          {
            "name": "tz",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "UTC"
            }
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Next cron runs"
          },
          "400": {
            "description": "Invalid cron or timezone"
          }
        }
      }
    },
    "/v1/timezone/convert": {
      "get": {
        "summary": "Convert an ISO timestamp to a target IANA timezone",
        "parameters": [
          {
            "name": "time",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "2026-11-25T12:00:00Z"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "UTC"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Converted timestamp"
          },
          "400": {
            "description": "Invalid parameter"
          }
        }
      }
    }
  }
}